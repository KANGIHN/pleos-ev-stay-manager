<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Read-only vehicle permissions. No CONTROL_* permission is requested. -->
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />
    <uses-permission android:name="pleos.car.permission.CAR_INFO" />
    <uses-permission android:name="pleos.car.permission.CAR_CLIMATE" />
    <uses-permission android:name="pleos.car.permission.CAR_SEATS" />
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />

    <!-- Warning notification when the app is not in the foreground. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Stay session monitor: keeps warnings running while the screen is off or another app is shown. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- NaviHelper: get*Info() and requestTrip() -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />

    <!-- AAOS GEAR_SELECTION (fallback when the Vehicle SDK gear is unavailable). -->
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.EvStay">

        <uses-library android:name="android.car" android:required="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.EvStay">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".StayMonitorService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Parked EV stay monitor: tracks battery drain while parked with climate on and warns before the user-set home-return reserve is reached." />
        </service>
    </application>

</manifest>
